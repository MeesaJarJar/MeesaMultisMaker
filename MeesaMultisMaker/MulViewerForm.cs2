        private void LoadButton_Click(object sender, EventArgs e)
        {
            using (var folderDialog = new FolderBrowserDialog())
            {
                folderDialog.Description = "Select folder containing multi.mul, multi.idx, art.mul, and artidx.mul";
                if (folderDialog.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        mulFolderPath = folderDialog.SelectedPath;
                        
                        // Load art from MUL folder
                        LoadArtFromMul();
                        
                        loadedMultis = MultiReader.Load(mulFolderPath);
                        
                        PopulateMultiList();

                        statusLabel.Text = $"Loaded {loadedMultis.Count} multis from {Path.GetFileName(mulFolderPath)}";
                        statusLabel.BackColor = Color.LightGreen;
                    }
                    catch (Exception ex)
                    {
                        statusLabel.Text = $"Error: {ex.Message}";
                        statusLabel.BackColor = Color.LightCoral;
                    }
                }
            }
        }

        private void MultiListBox_SelectedIndexChanged(object sender, EventArgs e)
        {
            int selectedCount = multiListBox.SelectedItems.Count;
      
            if (selectedCount == 0)
            {
                componentDataGrid.Rows.Clear();
                addToTrainingButton.Enabled = false;
                sendToCanvasButton.Enabled = false;
                infoTextBox.Text = "Select one or more multis from the list...\r\n(Use Ctrl/Shift for multi-select)";
                previewPictureBox.Invalidate();
                return;
            }

            // Show info for selected items
            if (selectedCount == 1)
            {
                var item = multiListBox.SelectedItem as MultiListItem;
                if (item == null) return;

                var entry = item.Entry;

                infoTextBox.Text = $"Multi ID: 0x{entry.Index:X4}\r\n" +
                    $"Components: {entry.Components.Count} | Entry Size: {entry.EntrySize} bytes";

                componentDataGrid.Rows.Clear();
                // Display in UO's multi component order: X, then Y, then Z
                foreach (var comp in entry.Components.OrderBy(c => c.X).ThenBy(c => c.Y).ThenBy(c => c.Z))
                {
                    componentDataGrid.Rows.Add(
                        $"0x{comp.TileId:X4}",
                        comp.X.ToString(),
                        comp.Y.ToString(),
                        comp.Z.ToString(),
                        comp.Flags.ToString()
                    );
                }

                bool hasComponents = entry.Components.Count > 0;
                addToTrainingButton.Enabled = hasComponents;
                sendToCanvasButton.Enabled = hasComponents;
            }
            else
            {
                // Multiple selection
                int totalComponents = 0;
                int nonEmptyCount = 0;
    
                foreach (MultiListItem item in multiListBox.SelectedItems)
                {
                    if (item?.Entry != null)
                    {
                        totalComponents += item.Entry.Components.Count;
                        if (item.Entry.Components.Count > 0)
                            nonEmptyCount++;
                    }
                }

                infoTextBox.Text = $"Selected: {selectedCount} multis\r\n" +
                    $"Non-empty: {nonEmptyCount} | Total components: {totalComponents}";

                componentDataGrid.Rows.Clear();
                addToTrainingButton.Enabled = nonEmptyCount > 0;
                // Only enable Send to Canvas for single selection
                sendToCanvasButton.Enabled = false;
            }

            previewPictureBox.Invalidate();
        }

        private void PreviewPictureBox_Paint(object sender, PaintEventArgs e)
        {
            var g = e.Graphics;
            g.Clear(Color.White);

            if (multiListBox.SelectedItems.Count != 1) return;

            var item = multiListBox.SelectedItem as MultiListItem;
            if (item?.Entry == null || item.Entry.Components.Count == 0) return;

            var entry = item.Entry;
   
            int minX = entry.Components.Min(c => c.X);
            int maxX = entry.Components.Max(c => c.X);
            int minY = entry.Components.Min(c => c.Y);
            int maxY = entry.Components.Max(c => c.Y);
            int minZ = entry.Components.Min(c => c.Z);
            int maxZ = entry.Components.Max(c => c.Z);

            int width = maxX - minX + 1;
            int height = maxY - minY + 1;

            const int TILE_WIDTH = 44;
            const int TILE_HEIGHT = 44;
            const int Z_PIXEL = 4;

            int canvasW = previewPictureBox.Width - 80; // More margin
            int canvasH = previewPictureBox.Height - 80;
 
            int isoWidth = (width + height) * (TILE_WIDTH / 2);
            // Account for Z-height in total height calculation
            int isoHeight = (width + height) * (TILE_HEIGHT / 2) + (maxZ - minZ) * Z_PIXEL;
       
            float zoom = Math.Min((float)canvasW / isoWidth, (float)canvasH / isoHeight);
            zoom = Math.Min(zoom, 1.0f);

            // Center the preview properly
            int offsetX = (previewPictureBox.Width - (int)(isoWidth * zoom)) / 2;
            // Account for Z offset in centering
            int zTotalOffset = (int)((maxZ - minZ) * Z_PIXEL * zoom);
            int offsetY = 40 + zTotalOffset; // Start lower to accommodate tall structures

            g.SmoothingMode = SmoothingMode.AntiAlias;

            // Draw faint grid background
            using (var gridPen = new Pen(Color.FromArgb(20, Color.LightGray)))
            {
                for (int y = 0; y < height; y++)
                {
                    for (int x = 0; x < width; x++)
                    {
                        float isoX = (x - y) * (TILE_WIDTH / 2f);
                        float isoY = (x + y) * (TILE_HEIGHT / 2f);

                        int sx = (int)(offsetX + isoX * zoom);
                        int sy = (int)(offsetY + isoY * zoom);
      
                        int hw = (int)Math.Round((TILE_WIDTH / 2f) * zoom);
                        int hh = (int)Math.Round((TILE_HEIGHT / 2f) * zoom);
    
                        Point[] diamond = new Point[]
                        {
                            new Point(sx, sy - hh),
                            new Point(sx + hw, sy),
                            new Point(sx, sy + hh),
                            new Point(sx - hw, sy)
                        };
  
                        g.DrawPolygon(gridPen, diamond);
                    }
                }
            }

            // Draw components with proper isometric draw order (painter's algorithm - back to front)
            // 1. Lower (X + Y) values first - these are further back in isometric view
            // 2. Within same depth (X+Y), lower Z values first - ground before elevated
            foreach (var comp in entry.Components
                .OrderBy(c => c.X + c.Y)  // Isometric depth: back to front
                .ThenBy(c => c.Z))        // Bottom to top
            {
                int gx = comp.X - minX;
                int gy = comp.Y - minY;
                int gz = comp.Z - minZ;

                float isoX = (gx - gy) * (TILE_WIDTH / 2f);
                float isoY = (gx + gy) * (TILE_HEIGHT / 2f);

                int sx = (int)(offsetX + isoX * zoom);
                int sy = (int)(offsetY + isoY * zoom);
   
                int zOffset = (int)Math.Round(gz * Z_PIXEL * zoom);
                new Point(sx, sy - tileSize/2),
                new Point(sx + tileSize/2, sy),
                new Point(sx, sy + tileSize/2),
                new Point(sx - tileSize/2, sy)
            };

            using (var brush = new SolidBrush(tileColor))
                g.FillPolygon(brush, diamond);

            using (var pen = new Pen(Color.Black, 1))
                g.DrawPolygon(pen, diamond);
        }

        private Color GetTileColor(ushort tileId, int relativeZ)
        {
            if (relativeZ == 0) return Color.SandyBrown;
            if (relativeZ < 5) return Color.BurlyWood;
            if (relativeZ < 10) return Color.Tan;
            if (relativeZ < 20) return Color.Peru;
            return Color.SaddleBrown;
        }

        private void AddToTrainingButton_Click(object sender, EventArgs e)
        {
            if (multiListBox.SelectedItems.Count == 0) return;

            var trainingData = new List<List<PlacedObject>>();
            int successCount = 0;

            foreach (MultiListItem item in multiListBox.SelectedItems)
            {
                if (item?.Entry == null || item.Entry.Components.Count == 0)
                    continue;

                var entry = item.Entry;
                var placedObjects = new List<PlacedObject>();

                int layer = 0;
                // Process in UO's multi component order: X, then Y, then Z
                foreach (var comp in entry.Components.OrderBy(c => c.X).ThenBy(c => c.Y).ThenBy(c => c.Z))
                {
                    string graphicId = $"0x{comp.TileId:X4}";
                    
                    // Load image from MUL only
                    Image img = LoadTileImage(comp.TileId);

                    placedObjects.Add(new PlacedObject
                    {
                        Image = img,
                        GraphicId = graphicId,
                        GridX = comp.X,
                        GridY = comp.Y,
                        Z = comp.Z,
                        Flags = comp.Flags,
                        Layer = layer++
                    });
                }

                if (placedObjects.Count > 0)
                {
                    trainingData.Add(placedObjects);
                    successCount++;
                }
            }

            if (trainingData.Count > 0)
            {
                TrainingDataReady?.Invoke(trainingData);   
                statusLabel.Text = $"Added {successCount} multi(s) to training data";
                statusLabel.BackColor = Color.LightGreen;
            }
            else
            {
                statusLabel.Text = "No valid multis to add to training";
                statusLabel.BackColor = Color.LightYellow;
            }
        }

        private void SendToCanvasButton_Click(object sender, EventArgs e)
        {
            if (multiListBox.SelectedItems.Count != 1) return;

            var item = multiListBox.SelectedItem as MultiListItem;
            if (item?.Entry == null || item.Entry.Components.Count == 0)
            {
                statusLabel.Text = "No valid multi selected";
                statusLabel.BackColor = Color.LightYellow;
                return;
            }

            var entry = item.Entry;
            var sb = new StringBuilder();

            // Generate text format: GraphicId X Y Z Flags
            foreach (var comp in entry.Components.OrderBy(c => c.X).ThenBy(c => c.Y).ThenBy(c => c.Z))
            {
                sb.AppendLine($"0x{comp.TileId:X4}   {comp.X}   {comp.Y}   {comp.Z}   {comp.Flags}   0");
            }

            string multiText = sb.ToString();
            
            // Fire the event to send to main form
            GeneratedTextReady?.Invoke(multiText);
            
            statusLabel.Text = $"Sent Multi 0x{entry.Index:X4} ({entry.Components.Count} items) to canvas";
            statusLabel.BackColor = Color.LightGreen;
        }

        private class MultiListItem
        {
            public MultiEntry Entry { get; set; }
            public string DisplayText { get; set; }
            public override string ToString() => DisplayText;
        }
    }
}
