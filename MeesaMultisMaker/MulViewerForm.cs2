        public MulViewerForm()
        {
            InitializeComponent();
            this.Load += MulViewerForm_Load;
        }

        private void MulViewerForm_Load(object sender, EventArgs e)
        {
            // Try to get MUL folder from config first
            var config = AppConfig.Instance;
            string defaultMulPath = config.MulFolderPath;
            
            // Fallback paths if config is empty
            if (string.IsNullOrEmpty(defaultMulPath) || !Directory.Exists(defaultMulPath))
            {
                // Try UOForever first
                defaultMulPath = @"C:\Program Files (x86)\UOForever\UO";
                
                if (!Directory.Exists(defaultMulPath))
                {
                    // Fallback to project directory for development
                    defaultMulPath = @"C:\Users\SERVER\source\repos\MeesaMultisMaker\MeesaMultisMaker";
                }
            }

            if (Directory.Exists(defaultMulPath))
            {
                try
                {
                    mulFolderPath = defaultMulPath;
                    
                    // Load art from MUL folder
                    LoadArtFromMul();
                    
                    loadedMultis = MultiReader.Load(mulFolderPath);
                    
                    PopulateMultiList();

                    statusLabel.Text = $"Auto-loaded {loadedMultis.Count} multis from {Path.GetFileName(mulFolderPath)}";
                    statusLabel.BackColor = Color.LightGreen;
                    loadButton.Visible = false;
                }
                catch (Exception ex)
                {
                    statusLabel.Text = $"Auto-load failed: {ex.Message}";
                    statusLabel.BackColor = Color.LightCoral;
                    loadButton.Text = "Retry Load";
                }
            }
            else
            {
                statusLabel.Text = "Multi files not found. Click 'Load Multi Files...' to browse.";
                statusLabel.BackColor = Color.LightYellow;
            }
        }
        
        /// <summary>
        /// Load art from MUL files only (art.mul/artidx.mul)
        /// </summary>
        private void LoadArtFromMul()
        {
            if (string.IsNullOrEmpty(mulFolderPath) || !Directory.Exists(mulFolderPath))
                return;

            try
            {
                // Check for traditional MUL format only
                if (File.Exists(Path.Combine(mulFolderPath, "art.mul")) && 
                    File.Exists(Path.Combine(mulFolderPath, "artidx.mul")))
                {
                    statusLabel.Text = statusLabel.Text + " | Using art.mul/artidx.mul";
                }
                else
                {
                    statusLabel.Text = statusLabel.Text + " | No art.mul files found - showing placeholders";
                    statusLabel.BackColor = Color.LightYellow;
                }
            }
            catch (Exception ex)
            {
                statusLabel.Text += $" | Art init error: {ex.Message}";
                statusLabel.BackColor = Color.LightYellow;
            }
        }

        private void HideEmptyCheckBox_CheckedChanged(object sender, EventArgs e)
        {
            hideEmptyMultis = hideEmptyCheckBox.Checked;
            PopulateMultiList();
        }

        private void FilterChanged(object sender, EventArgs e)
        {
            PopulateMultiList();
        }

        /// <summary>
        /// Calculate the width and height of a multi based on its components
        /// </summary>
        private (int width, int height) GetMultiDimensions(MultiEntry entry)
        {
            if (entry.Components.Count == 0)
                return (0, 0);

            int minX = entry.Components.Min(c => c.X);
            int maxX = entry.Components.Max(c => c.X);
            int minY = entry.Components.Min(c => c.Y);
            int maxY = entry.Components.Max(c => c.Y);

            return (maxX - minX + 1, maxY - minY + 1);
        }
 
        private void PopulateMultiList()
        {
            multiListBox.Items.Clear();
            
            // Get filter values
            int minW = minWidthFilter != null ? (int)minWidthFilter.Value : 1;
            int maxW = maxWidthFilter != null ? (int)maxWidthFilter.Value : 100;
            int minH = minHeightFilter != null ? (int)minHeightFilter.Value : 1;
            int maxH = maxHeightFilter != null ? (int)maxHeightFilter.Value : 100;

            int visibleCount = 0;
            int filteredBySize = 0;

            foreach (var entry in loadedMultis)
            {
                // Skip empty multis if hide option is enabled
                if (hideEmptyMultis && entry.Components.Count == 0)
                    continue;

                // Apply size filter
                if (entry.Components.Count > 0)
                {
                    var (width, height) = GetMultiDimensions(entry);
                    if (width < minW || width > maxW || height < minH || height > maxH)
                    {
                        filteredBySize++;
                        continue;
                    }
                }
         
                string displayText = entry.Components.Count > 0
                    ? $"Multi ID: 0x{entry.Index:X4} ({entry.Components.Count} components)"
                    : $"Multi ID: 0x{entry.Index:X4} (empty)";
  
                multiListBox.Items.Add(new MultiListItem 
                { 
                    Entry = entry, 
                    DisplayText = displayText 
                });
        
                visibleCount++;
            }
       
            // Update status to show filtered count
            string statusText = $"Showing {visibleCount} multis";
            if (filteredBySize > 0)
            {
                statusText += $" ({filteredBySize} filtered by size)";
            }
            if (hideEmptyMultis)
            {
                int emptyCount = loadedMultis.Count(m => m.Components.Count == 0);
                if (emptyCount > 0)
                    statusText += $" ({emptyCount} empty hidden)";
            }
            statusLabel.Text = statusText;
        }

        private Image LoadTileImage(ushort tileId)
        {
            if (artCache.ContainsKey(tileId))
                return artCache[tileId];

            Bitmap img = null;

            try
            {
                // Check for traditional MUL format only
                bool hasMul = File.Exists(Path.Combine(mulFolderPath, "art.mul")) && 
                             File.Exists(Path.Combine(mulFolderPath, "artidx.mul"));
                
                if (hasMul)
                {
                    img = StaticArtReader.LoadStaticArt(mulFolderPath, tileId);
                }

                if (img != null)
                {
                    artCache[tileId] = img;
                    return img;
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"MulViewer: EXCEPTION loading art 0x{tileId:X4}: {ex.Message}");
            }

            return null;
        }

